# Base URL the frontend calls for the Rails API.
#
# Leave unset for local dev — Vite's dev-server proxy (vite.config.ts) already forwards /api/*
# requests to http://localhost:3000, so relative paths work with no env var needed.
#
# Required for any production build where the built frontend assets are served from a different
# origin than the Rails API (the normal case) — this is the frontend-side counterpart of the
# backend's FRONTEND_ORIGIN env var (config/initializers/cors.rb); the two must point at each
# other (VITE_API_BASE_URL = wherever Rails is deployed, FRONTEND_ORIGIN = wherever this build is
# deployed).
VITE_API_BASE_URL=
